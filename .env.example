# MediaMTX v1.20.1-ffmpeg, pinned to the digest used by the local smoke test.
MEDIAMTX_IMAGE=bluenviron/mediamtx@sha256:16c56911dbd1fd7a85455042fa8320779fc8bf6575c6903f74023b202c1a620c
MEDIAMTX_LOG_LEVEL=info
# Optional Docker Desktop/VPN relay. Leave empty when MediaMTX can route to HLS sources directly.
MEDIAMTX_HLS_PROXY_BASE_URL=
# The splitter status endpoint is only used by control-api; keep it private.
SPLITTER_STATUS_URL=http://host.docker.internal:9101
# Used by udp-splitter when MediaMTX listens on the same Linux host.
SPLITTER_MEDIAMTX_RTMP_BASE=rtmp://127.0.0.1:1935
SPLITTER_HTTP_ADDR=127.0.0.1:9101
# Public base used when the control API returns generated RTMP addresses.
PUBLIC_RTMP_BASE_URL=rtmp://localhost:1935
PUBLIC_HLS_BASE_URL=http://localhost:8080/hls

HLS_PORT=8888
# Bind RTMP to localhost by default; production external access requires 0.0.0.0
RTMP_BIND=127.0.0.1
RTMP_PORT=1935
API_PORT=19997
METRICS_PORT=19998
SINK_API_PORT=29997

CONTROL_API_PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Replace with a long random value before storing real stream keys.
STREAM_KEY_ENCRYPTION_KEY=local-change-me
TZ=Asia/Shanghai
